# Fragment only. Merge into the EXISTING nginx configuration; keep SSL/listen/upstream settings.
# Inside http {}, once (do not duplicate if already present):
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Inside the existing API server {}:
location = /api/game/air-hockey/pvp/ws {
    # Replace with the SAME backend upstream/port used by existing /api/ requests.
    proxy_pass http://127.0.0.1:10000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_buffering off;
}
